{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["id", "username", "accessToken", "refreshToken"],
  "properties": {
    "id": {"type": "integer"},
    "username": {"type": "string"},
    "accessToken": {"type": "string", "minLength": 1},
    "refreshToken": {"type": "string", "minLength": 1}
  }
}
