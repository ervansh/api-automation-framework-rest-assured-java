<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="API Automation Suite" parallel="tests" thread-count="3" data-provider-thread-count="3">
    <listeners>
        <listener class-name="com.ervansh.apiautomation.listeners.TestExecutionListener"/>
    </listeners>
    <test name="Framework Configuration">
        <groups><run><include name="configuration"/></run></groups>
        <classes>
            <class name="com.ervansh.apiautomation.core.config.FrameworkConfigTest"/>
        </classes>
    </test>
    <test name="Product API">
        <groups><run><include name="smoke"/><include name="regression"/></run></groups>
        <classes>
            <class name="com.ervansh.apiautomation.services.products.ProductApiClientTest"/>
        </classes>
    </test>
</suite>
